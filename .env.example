# 生产环境环境变量配置模版
NODE_ENV=production
PORT=3000


# 分系统/租户主体标识 (default: 阳澄股份 / maoshi: 毛氏水产)
TENANT=default
NEXT_PUBLIC_TENANT=default

# 超级管理员初始化配置 (执行清库初始化脚本时生效)
INITIAL_ADMIN_PHONE=13800000001
INITIAL_ADMIN_PASSWORD=Admin#2026!YC
INITIAL_ADMIN_NAME="系统超级管理员"

# Docker 容器内部持久化数据库路径（映射至宿主机 ./data/db/app.db）
DATABASE_URL="file:/app/data/app.db"
AUTH_SECRET="yangcheng-tracehub-secret-key-prod-2026-auth-session"

# 阿里云 OSS (可选，若不填则自动降级为本地存储 public/uploads)
# OSS_BUCKET: 您的 Bucket 名称 (例如 yangcheng-trace-prod)
OSS_BUCKET=
# OSS_ENDPOINT: 地域节点，请务必与阿里云控制台创建 Bucket 时选择的地域保持一致
# (例如：华东2上海为 oss-cn-shanghai.aliyuncs.com，华东1杭州为 oss-cn-hangzhou.aliyuncs.com)
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS_PUBLIC_DOMAIN (可选): 仅在配置了自定义独立 CDN 域名时填写 (例如: https://cdn.yourdomain.com)
# 请勿在此处重复填写不带 Bucket 前缀的地域接入点 (如 oss-cn-shanghai.aliyuncs.com)
OSS_PUBLIC_DOMAIN=

# 阿里云验证码 2.0 (可选，若不填则降级为免验放行)
NEXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_ID=
NEXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-hangzhou.aliyuncs.com

