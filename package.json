    "test:unit": "tsx tests/invariants.test.ts",
    "test:directives": "tsx tests/client-directives.test.ts",
    "test:e2e": "tsx tests/e2e-workflow.test.ts",
    "test:smoke": "tsx tests/smoke-routes.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "dependencies": {
    "@alicloud/captcha20230305": "^1.1.4",
