{
  "name": "yangcheng-tracehub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
